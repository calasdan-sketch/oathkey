{
  "cli_token": {
    "login": [
      "gh",
      "auth",
      "login",
      "--web"
    ],
    "token": [
      "gh",
      "auth",
      "token"
    ]
  },
  "display": "GitHub",
  "docs": "https://docs.github.com/en/authentication/keeping-your-account-and-data-secure/managing-your-personal-access-tokens",
  "env_var": "GITHUB_TOKEN",
  "fields": [
    {
      "env_var": "GITHUB_TOKEN",
      "label": "token",
      "name": "key",
      "detect": "(gh[pousr]_|github_pat_)[A-Za-z0-9_.-]{20,255}",
      "detect_confidence": "known",
      "capture_accept": "^(gh[pousr]_[A-Za-z0-9]{36}|github_pat_[A-Za-z0-9_]{22,255})\\Z"
    }
  ],
  "key_url": "https://github.com/settings/personal-access-tokens/new",
  "scopes": [],
  "service": "github",
  "steps": [
    "Choose 'Fine-grained personal access token' (the page opens on it)",
    "Name it after the project and pick an expiration",
    "Choose the one repository (or only the repositories) it needs, then the smallest permissions that work",
    "Click 'Generate token' at the bottom",
    "Copy the token now - it is shown exactly once"
  ],
  "validate": {
    "auth": {
      "type": "bearer"
    },
    "expect": [
      200
    ],
    "identity": "login",
    "method": "GET",
    "url": "https://api.github.com/user",
    "reject": [
      401
    ],
    "limited": [
      {
        "status": 403,
        "meaning": "the token is valid but this kind of token may not read your user profile; that is fine"
      }
    ]
  },
  "least_privilege": {
    "summary": "Fine-grained token, one repository, only the permissions you need, with an expiry. Avoid classic tokens with the broad 'repo' scope.",
    "url": "https://github.com/settings/personal-access-tokens/new"
  },
  "revoke": {
    "api": {
      "method": "POST",
      "url": "https://api.github.com/credentials/revoke",
      "auth": {
        "type": "json_list",
        "field": "credentials"
      },
      "headers": {
        "Accept": "application/vnd.github+json"
      },
      "expect": [
        202
      ]
    },
    "page": "https://github.com/settings/personal-access-tokens",
    "steps": [
      "Find the leaked token in the list (classic tokens are under 'Tokens (classic)')",
      "Click Delete (or Revoke) and confirm"
    ]
  }
}
