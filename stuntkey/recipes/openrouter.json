{
  "display": "OpenRouter",
  "docs": "https://openrouter.ai/docs/api_reference/authentication",
  "env_var": "OPENROUTER_API_KEY",
  "fields": [
    {
      "env_var": "OPENROUTER_API_KEY",
      "label": "API key",
      "name": "key",
      "detect": "sk-or-[A-Za-z0-9_.-]{16,}",
      "detect_confidence": "guess"
    }
  ],
  "key_url": "https://openrouter.ai/keys",
  "scopes": [],
  "service": "openrouter",
  "steps": [
    "Sign in to OpenRouter",
    "Click 'Create API Key'",
    "Give it a name for this project",
    "Set a small credit limit (the docs recommend one on every key)",
    "Click 'Create' and copy the key - it is shown exactly once"
  ],
  "validate": {
    "auth": {
      "type": "bearer"
    },
    "expect": [
      200
    ],
    "method": "GET",
    "url": "https://openrouter.ai/api/v1/key"
  },
  "least_privilege": {
    "summary": "Always set a credit limit on the key."
  }
}
