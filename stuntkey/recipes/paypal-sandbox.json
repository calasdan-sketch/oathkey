{
  "display": "PayPal (Sandbox REST app)",
  "docs": "https://developer.paypal.com/api/rest/authentication/",
  "env_var": "PAYPAL_SANDBOX_CLIENT_ID",
  "fields": [
    {
      "env_var": "PAYPAL_SANDBOX_CLIENT_ID",
      "label": "Client ID",
      "name": "client_id"
    },
    {
      "env_var": "PAYPAL_SANDBOX_CLIENT_SECRET",
      "label": "Secret",
      "name": "client_secret"
    }
  ],
  "key_url": "https://developer.paypal.com/dashboard/applications/sandbox",
  "scopes": [],
  "service": "paypal-sandbox",
  "steps": [
    "Sign in to developer.paypal.com and switch the toggle to Sandbox (use the 'paypal' recipe for live keys)",
    "Open Apps & Credentials and create an app (or open yours)",
    "Copy the Client ID, then click Show under Secret and copy it"
  ],
  "validate": {
    "auth": {
      "token_only": true,
      "token_url": "https://api-m.sandbox.paypal.com/v1/oauth2/token",
      "type": "oauth2_client_credentials"
    },
    "expect": [
      200
    ],
    "method": "GET",
    "url": "https://api-m.sandbox.paypal.com/v1/oauth2/token"
  },
  "least_privilege": {
    "summary": "Sandbox keys move no real money; use them while building."
  }
}
