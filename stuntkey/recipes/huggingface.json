{
  "display": "Hugging Face",
  "docs": "https://huggingface.co/docs/hub/security-tokens",
  "env_var": "HF_TOKEN",
  "fields": [
    {
      "env_var": "HF_TOKEN",
      "label": "API key",
      "name": "key",
      "detect": "hf_[A-Za-z0-9_.-]{16,}",
      "detect_confidence": "guess"
    }
  ],
  "key_url": "https://huggingface.co/settings/tokens",
  "scopes": [],
  "service": "huggingface",
  "steps": [
    "Sign in; this is Settings → Access Tokens",
    "Click 'Create new token'",
    "Pick 'Fine-grained' and tick only what the app needs ('Read' is enough for downloading models)",
    "Name it, click 'Create token' and copy it - it is shown exactly once"
  ],
  "validate": {
    "auth": {
      "type": "bearer"
    },
    "expect": [
      200
    ],
    "method": "GET",
    "url": "https://huggingface.co/api/whoami-v2"
  },
  "least_privilege": {
    "summary": "Use a fine-grained token, one per app.",
    "url": "https://huggingface.co/settings/tokens"
  }
}
