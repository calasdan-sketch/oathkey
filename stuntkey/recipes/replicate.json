{
  "display": "Replicate",
  "docs": "https://replicate.com/docs/reference/http",
  "env_var": "REPLICATE_API_TOKEN",
  "fields": [
    {
      "env_var": "REPLICATE_API_TOKEN",
      "label": "API key",
      "name": "key",
      "accept": "^r8_.{37}$",
      "detect": "r8_[A-Za-z0-9]{37}",
      "detect_confidence": "known",
      "capture_accept": "^r8_[A-Za-z0-9]{37}\\Z"
    }
  ],
  "key_url": "https://replicate.com/account/api-tokens",
  "scopes": [],
  "service": "replicate",
  "steps": [
    "Sign in to Replicate",
    "Enter a token name and click 'Create token'",
    "Copy the token (starts with 'r8_')"
  ],
  "validate": {
    "auth": {
      "type": "bearer"
    },
    "expect": [
      200
    ],
    "method": "GET",
    "url": "https://api.replicate.com/v1/account"
  },
  "least_privilege": {
    "summary": "Make a separate key for this one project, so you can revoke it without breaking anything else."
  }
}
